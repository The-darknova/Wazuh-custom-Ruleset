<group name="windows,brute_force,">
  <rule id="150000" level="10" frequency="10" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Windows: Multiple Logon Failures (Brute Force) from same source IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>
</group>
