<group name="nginx,brute_force,">
  <rule id="150300" level="10" frequency="20" timeframe="60">
    <if_matched_sid>31315</if_matched_sid>
    <same_source_ip />
    <description>Nginx: Multiple Web Authentication Failures (Brute Force) from same source IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>
</group>
